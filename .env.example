# Copy to .env to override defaults
OCR_MODEL=PP-OCRv6_medium
OCR_ENGINE=paddle
OCR_DEVICE=cpu
OCR_CPU_THREADS=4
OCR_MAX_MB=15

# Guided extraction (/api/extract) — any OpenAI-compatible endpoint.
# Local Ollama example: LLM_BASE_URL=http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=60

# Per-request debug traces for POST /extract/invoice (see app/core/debug_trace.py).
# Each request writes 01_request / 02_ocr / 03_llm_request / 04_llm_response /
# 05_extracted / 06_match / 07_response / 08_meta (+ error.json on failure).
IDP_DEBUG_TRACE=1
IDP_DEBUG_DIR=output/debug
IDP_DEBUG_KEEP=100
# IDP_DEBUG_SAVE_UPLOADS=1 also stores the uploaded file (00_upload.*). Off by
# default to avoid filling disk with 15 MB blobs.
